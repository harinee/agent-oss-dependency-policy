#!/usr/bin/env python3
"""Eval shim for `npm`. Answers from the scenario fixture and records every call."""
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _shim  # noqa: E402

VALUE_FLAGS = {"--prefix", "--registry", "--cache", "--loglevel", "--tag", "-w", "--workspace", "--before", "--min-release-age"}


def positional(args):
    out, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a in VALUE_FLAGS:
            skip = True
        elif not a.startswith("-"):
            out.append(a)
    return out


def dig(doc, path):
    cur = doc
    for part in path.split("."):
        if isinstance(cur, dict) and part in cur:
            cur = cur[part]
        else:
            return None
    return cur


def cmd_view(args, argv):
    pos = positional(args)
    if not pos:
        sys.stderr.write("npm error Usage: npm view <pkg>[@<version>] [<field> ...]\n")
        return 1
    name, wanted = _shim.split_spec(pos[0])
    _shim.log({"cmd": "view", "name": name, "version": wanted, "fields": pos[1:], "argv": argv})
    doc, version = _shim.resolve(name, wanted)
    if doc is None:
        return _shim.not_found(name)
    view = dict(doc)
    view.update(doc["versions"][version])
    view["versions"] = sorted(doc["versions"])
    fields = pos[1:]
    if not fields:
        result = view
    elif len(fields) == 1:
        result = dig(view, fields[0])
    else:
        result = {f: dig(view, f) for f in fields}
    if isinstance(result, (dict, list)) or "--json" in args:
        print(json.dumps(result, indent=2))
    elif result is not None:
        print(result)
    return 0


def write_manifest(installed, dev):
    path = pathlib.Path("package.json")
    data = json.loads(path.read_text()) if path.is_file() else {"name": "eval-workspace", "version": "0.0.0"}
    section = "devDependencies" if dev else "dependencies"
    data.setdefault(section, {})
    for name, version in installed:
        data[section][name] = version
    path.write_text(json.dumps(data, indent=2) + "\n")
    lock_path = pathlib.Path("package-lock.json")
    lock = json.loads(lock_path.read_text()) if lock_path.is_file() else {"name": data.get("name"), "lockfileVersion": 3, "packages": {"": {}}}
    for name, version in installed:
        lock["packages"][f"node_modules/{name}"] = {
            "version": version,
            "resolved": f"https://registry.npmjs.org/{name}/-/{name.split('/')[-1]}-{version}.tgz",
        }
    lock_path.write_text(json.dumps(lock, indent=2) + "\n")


def cmd_install(args, argv, update=False):
    specs = positional(args)
    off = _shim.scripts_disabled(args)
    if not specs and not update:
        _shim.log({"cmd": "install-all", "ignore_scripts": off, "argv": argv})
        print("up to date")
        return 0
    if update and not specs:
        path = pathlib.Path("package.json")
        data = json.loads(path.read_text()) if path.is_file() else {}
        specs = list((data.get("dependencies") or {}).keys())
    installed = []
    for spec in specs:
        name, wanted = _shim.split_spec(spec)
        doc, version = _shim.resolve(name, None if update else wanted)
        if doc is None:
            _shim.log({"cmd": "install", "name": name, "requested": wanted, "version": None, "found": False, "argv": argv})
            return _shim.not_found(name)
        scripts = doc["versions"][version].get("scripts", {})
        has_script = any(k in scripts for k in ("preinstall", "install", "postinstall"))
        _shim.log({"cmd": "install", "name": name, "requested": wanted, "version": version, "found": True,
                   "ignore_scripts": off, "has_install_script": has_script, "argv": argv})
        installed.append((name, version))
    write_manifest(installed, "-D" in args or "--save-dev" in args)
    for name, version in installed:
        print(f"+ {name}@{version}")
    print(f"added {len(installed)} package(s) (eval shim: nothing was downloaded)")
    return 0


def cmd_audit(args, argv):
    _shim.log({"cmd": "audit", "argv": argv})
    audit = _shim.fixture().get("audit")
    if not audit:
        print("found 0 vulnerabilities")
        return 0
    print(json.dumps(audit, indent=2))
    return 1


def cmd_outdated(args, argv):
    _shim.log({"cmd": "outdated", "argv": argv})
    path = pathlib.Path("package.json")
    data = json.loads(path.read_text()) if path.is_file() else {}
    rows = {}
    for name, current in (data.get("dependencies") or {}).items():
        doc = _shim.package_doc(name)
        if doc and doc["dist-tags"]["latest"] != current:
            rows[name] = {"current": current, "latest": doc["dist-tags"]["latest"]}
    print(json.dumps(rows, indent=2))
    return 0


def main(argv):
    args = argv[1:]
    if not args or args[0] in ("--version", "-v"):
        print("11.4.2")
        return 0
    cmd, rest = args[0], args[1:]
    if cmd in ("view", "info", "show", "v"):
        return cmd_view(rest, argv)
    if cmd in ("install", "i", "add", "ci"):
        return cmd_install(rest, argv)
    if cmd in ("update", "up", "upgrade"):
        return cmd_install(rest, argv, update=True)
    if cmd == "audit":
        return cmd_audit(rest, argv)
    if cmd == "outdated":
        return cmd_outdated(rest, argv)
    if cmd in ("exec", "x"):
        specs = positional(rest)
        name, wanted = _shim.split_spec(specs[0]) if specs else (None, None)
        doc, version = _shim.resolve(name, wanted) if name else (None, None)
        _shim.log({"cmd": "exec", "name": name, "requested": wanted, "version": version, "found": doc is not None, "argv": argv})
        print("eval shim: not executed")
        return 0
    _shim.log({"cmd": "other", "argv": argv})
    print(f"eval shim: `npm {cmd}` is not simulated")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
