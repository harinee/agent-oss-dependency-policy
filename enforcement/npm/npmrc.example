# Copy to .npmrc in the project root.
# Mirrors: AGE-1 (version cooldown), SCR-1 (install scripts off), PIN-1 (exact versions).

# Refuse versions published less than 3 days ago. Requires npm 11.10.0 or later;
# older npm versions print an "Unknown project config" warning and do not apply it.
min-release-age=3

# Do not run lifecycle scripts. This also skips the project's own pre/post
# scripts, so call build steps explicitly. npm 12 blocks dependency scripts by
# default and has an allowlist (`npm approve-scripts`); with npm 12 you can
# remove this line and use the allowlist instead.
ignore-scripts=true

# Write exact versions to package.json.
save-exact=true
